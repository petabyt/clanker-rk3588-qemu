+/*
+ * RMR_EL3/RMR: AA64 (bit 0) reads as 1. A write with RR (bit 1) requests a
+ * warm reset. The guest uses it to restart through reset (rk3588 BL31 0x58874);
+ * here that is a full machine reset, and RAM/stub state survive it as on
+ * the part.
+ */
+static uint64_t rmr_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    return 1;
+}
+
+static void rmr_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                      uint64_t value)
+{
+    if (value & 2) {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
