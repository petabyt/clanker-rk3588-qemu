+    memcpy(pattern + sizeof(sd_tuning_block_pattern4),
+           sd_tuning_block_pattern4, sizeof(sd_tuning_block_pattern4));
+
+    return sd_cmd_to_sendingdata(sd, req, 0, pattern, sizeof(pattern));
