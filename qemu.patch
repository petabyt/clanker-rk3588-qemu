diff --git a/hw/sd/sdhci.c b/hw/sd/sdhci.c
index bd74c60..a1f2dc3 100644
--- a/hw/sd/sdhci.c
+++ b/hw/sd/sdhci.c
@@ -364,6 +364,23 @@ static void sdhci_send_command(SDHCIState *s)
     request.cmd = s->cmdreg >> 8;
     request.arg = s->argument;
 
+    /*
+     * Automatically send CMD23 (SET_BLOCK_COUNT) before a multi-block
+     * data command when Auto CMD23 is enabled: the card needs the block
+     * count to terminate the transfer by itself; without it an
+     * open-ended CMD18/25 leaves the card stuck in the data-transfer
+     * state after the host has finished the transfer.
+     */
+    if ((s->trnmod & SDHC_TRNS_ACMD23) &&
+        (s->trnmod & SDHC_TRNS_MULTI) &&
+        (s->cmdreg & SDHC_CMD_DATA_PRESENT)) {
+        SDRequest acmd23 = {
+            .cmd = 23,
+            .arg = s->blkcnt,
+        };
+        sdbus_do_command(&s->sdbus, &acmd23, response, sizeof(response));
+    }
+
     trace_sdhci_send_command(request.cmd, request.arg);
     rlen = sdbus_do_command(&s->sdbus, &request, response, sizeof(response));
 
@@ -450,10 +467,13 @@ static void sdhci_read_block_from_card(SDHCIState *s)
         return;
     }
 
-    if (!FIELD_EX32(s->hostctl2, SDHC_HOSTCTL2, EXECUTE_TUNING)) {
-        /* Device is not in tuning */
-        sdbus_read_data(&s->sdbus, s->fifo_buffer, blk_size);
-    }
+    /*
+     * Consume the block from the card in tuning mode as well: the
+     * driver never reads the tuning pattern (no Buffer Data Port
+     * access), so a skipped read would leave the card stuck in the
+     * data-transfer state.
+     */
+    sdbus_read_data(&s->sdbus, s->fifo_buffer, blk_size);
 
     if (FIELD_EX32(s->hostctl2, SDHC_HOSTCTL2, EXECUTE_TUNING)) {
         /* Device is in tuning */
@@ -461,6 +481,14 @@ static void sdhci_read_block_from_card(SDHCIState *s)
         s->hostctl2 |= R_SDHC_HOSTCTL2_SAMPLING_CLKSEL_MASK;
         s->prnsts &= ~(SDHC_DAT_LINE_ACTIVE | SDHC_DOING_READ |
                        SDHC_DATA_INHIBIT);
+        /*
+         * The tuning cycle is a data-less 64/128-byte read: the driver
+         * (sdhci_send_tuning) completes the cycle on Buffer Read Ready,
+         * so raise it here or the tuning window times out.
+         */
+        if (s->norintstsen & SDHC_NISEN_RBUFRDY) {
+            s->norintsts |= SDHC_NIS_RBUFRDY;
+        }
         goto read_done;
     }
 
